{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wasm Runner application",
  "description": "An application of named WebAssembly functions with HTTP routes.",
  "type": "object",
  "required": ["name", "functions"],
  "additionalProperties": false,
  "properties": {
    "name": { "$ref": "#/definitions/identifier" },
    "dependencies": { "$ref": "#/definitions/dependencies" },
    "functions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "additionalProperties": { "$ref": "#/definitions/function" }
    }
  },
  "definitions": {
    "dependencies": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/definitions/dependency" }
    },
    "dependency": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["version"],
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "features": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "default-features": { "type": "boolean" }
          }
        }
      ]
    },
    "identifier": {
      "description": "A lowercase identifier of 1 to 64 letters, digits, or hyphens, starting with a letter.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "function": {
      "type": "object",
      "required": ["http"],
      "additionalProperties": false,
      "properties": {
        "dependencies": { "$ref": "#/definitions/dependencies" },
        "http": {
          "type": "object",
          "required": ["method", "path"],
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
            },
            "path": {
              "description": "An exact route starting with /; no whitespace, control characters, query, fragment, percent escapes, or wildcards.",
              "type": "string",
              "pattern": "^/[^\\s\\u0000-\\u001f\\u007f-\\u009f?#%*{}\\[\\]]*$"
            }
          }
        }
      }
    }
  }
}
